# Remote browserControl gateway
BROWSERCONTROL_GATEWAY_HOST=0.0.0.0
BROWSERCONTROL_GATEWAY_PORT=8787

# Model-facing MCP capability secret. Production should eventually use MCP-standard OAuth.
BROWSERCONTROL_MCP_TOKEN=replace-with-at-least-32-random-bytes

# Separate admin secret for pairing creation, device listing and revocation.
# Never give this credential to an AI connector.
BROWSERCONTROL_ADMIN_TOKEN=replace-with-a-different-long-random-secret

# Reverse-proxy deployments (Render, Fly, etc.) may opt in to X-Forwarded-For
# for pairing/MCP rate limiting. Leave off unless the gateway is behind a trusted proxy.
BROWSERCONTROL_TRUST_PROXY=1

# LOCAL LOOPBACK DEVELOPMENT ONLY:
# BROWSERCONTROL_DEVICE_TOKEN=replace-with-a-long-random-development-secret
# Public/non-loopback gateways reject the static device-token path and require revocable pairing.
