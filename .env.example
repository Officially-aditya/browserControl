# browserControl public relay
BROWSERCONTROL_GATEWAY_HOST=0.0.0.0
BROWSERCONTROL_GATEWAY_PORT=8787

# Admin-only secret for pairing creation, device listing, connector rotation and revocation.
# Never give this credential to Claude or another AI connector.
BROWSERCONTROL_ADMIN_TOKEN=replace-with-a-long-random-secret

# MCP OAUTH / CLAUDE
# Public relays expose RFC 9728 / RFC 8414 OAuth discovery, DCR, PKCE authorization,
# rotating refresh tokens, and device-scoped access tokens when a public origin is known.
# Railway is auto-detected from RAILWAY_PUBLIC_DOMAIN, so no extra variable is needed there.
# Other hosts should set an HTTPS origin with no path/query/fragment, for example:
# BROWSERCONTROL_PUBLIC_BASE_URL=https://relay.example.com

# HORIZONTAL SCALING / SHARED STATE
# Point every relay replica at the same persistent Redis deployment. browserControl stores
# only credential digests/metadata, pairing tickets, OAuth state, distributed rate-limit
# counters and short-lived device-presence records there; screenshots and browser RPC
# payloads do not pass through Redis.
# BROWSERCONTROL_REDIS_URL=rediss://default:password@redis.internal:6379/0
# BROWSERCONTROL_REDIS_PREFIX=browsercontrol

# Shared secret used only for authenticated relay-to-relay forwarding. Every replica in
# one cluster must use the same value. Never expose it to the extension or MCP client.
# BROWSERCONTROL_RELAY_CLUSTER_TOKEN=replace-with-a-different-long-random-secret

# Stable unique ID for this process/replica. If omitted browserControl derives one from
# hostname + PID, but orchestrators should provide a stable instance identifier.
# BROWSERCONTROL_RELAY_REPLICA_ID=relay-01

# A per-replica private HTTP(S) origin reachable by peer relay replicas. This must resolve
# to THIS replica, not the public load-balancer URL, otherwise forwarding can loop.
# BROWSERCONTROL_RELAY_INTERNAL_URL=https://relay-01.internal.example

# Presence TTL is refreshed while the extension WebSocket is alive. If a replica dies,
# ownership disappears automatically and the extension reconnects through the load balancer.
# BROWSERCONTROL_PRESENCE_TTL_MS=60000

# SINGLE-REPLICA DURABLE FALLBACK
# When Redis is not configured, an individual relay can persist hashed device credentials
# to a local durable disk. Do not use this file mode across multiple replicas. OAuth state
# is in-memory in this mode, so active OAuth sessions do not survive process restarts.
# BROWSERCONTROL_DEVICE_STORE_PATH=/var/data/browsercontrol-devices.json

# Reverse-proxy deployments (Render, Fly, ECS, Kubernetes, etc.) may opt in to
# X-Forwarded-For for pairing/MCP rate limiting. Leave at 0 unless the relay is
# behind a trusted proxy that overwrites this header; otherwise clients can spoof
# IPs and defeat per-IP rate limits.
# BROWSERCONTROL_TRUST_PROXY=0

# LOCAL LOOPBACK DEVELOPMENT ONLY:
# BROWSERCONTROL_DEVICE_TOKEN=replace-with-a-long-random-development-secret
# BROWSERCONTROL_MCP_TOKEN=replace-with-a-different-local-development-secret
# Public relays reject these global/static credentials. Pairing provisions a distinct
# extension token and MCP connector token for every device.
