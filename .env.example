# browserControl public relay
BROWSERCONTROL_GATEWAY_HOST=0.0.0.0
BROWSERCONTROL_GATEWAY_PORT=8787

# Admin-only secret for pairing creation, device listing, connector rotation and revocation.
# Never give this credential to Claude or another AI connector.
BROWSERCONTROL_ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional durable device registry. The file stores only SHA-256 credential digests,
# never raw extension or MCP tokens. On hosted infrastructure this path must live
# on durable storage (for example a persistent disk mounted at /var/data).
# BROWSERCONTROL_DEVICE_STORE_PATH=/var/data/browsercontrol-devices.json

# Reverse-proxy deployments (Render, Fly, etc.) may opt in to X-Forwarded-For
# for pairing/MCP rate limiting. Leave off unless the relay is behind a trusted proxy.
BROWSERCONTROL_TRUST_PROXY=1

# LOCAL LOOPBACK DEVELOPMENT ONLY:
# BROWSERCONTROL_DEVICE_TOKEN=replace-with-a-long-random-development-secret
# BROWSERCONTROL_MCP_TOKEN=replace-with-a-different-local-development-secret
# Public relays reject these global/static credentials. Pairing provisions a distinct
# extension token and MCP connector token for every device.
