# Remote browserControl gateway
BROWSERCONTROL_GATEWAY_HOST=0.0.0.0
BROWSERCONTROL_GATEWAY_PORT=8787

# Long random capability secret used by the Chrome extension.
BROWSERCONTROL_DEVICE_TOKEN=replace-with-at-least-32-random-bytes

# MVP MCP capability secret. Production should use MCP-standard OAuth instead.
BROWSERCONTROL_MCP_TOKEN=replace-with-a-different-long-random-secret
