{
  "manifest_version": 3,
  "name": "browserControl",
  "version": "0.2.0",
  "description": "Securely let connected AI clients control the Chrome tab you explicitly share.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "storage", "activeTab"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "browserControl",
    "default_popup": "popup.html"
  }
}
